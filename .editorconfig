root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 2

# Go uses tabs (gofmt requirement).
[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum}]
indent_style = tab
indent_size = 4

# Makefile / justfile rely on tabs in recipe bodies.
[{Makefile,justfile,*.mk}]
indent_style = tab
indent_size = 4

# Shell scripts.
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Python (if any helper scripts).
[*.py]
indent_style = space
indent_size = 4

# TOML keeps 4 spaces.
[*.toml]
indent_style = space
indent_size = 4

# Markdown: preserve trailing whitespace (two-space line breaks).
[*.md]
trim_trailing_whitespace = false
